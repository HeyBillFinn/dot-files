#!/usr/bin/env python3
"""Interactive triage tool for RUN_TERMINAL_SDK Jira tickets."""

import curses
import http.client
import json
import os
import socket
import subprocess
import textwrap
import threading
import urllib.parse

JIRA_HOST = "jira.corp.stripe.com"
UNIX_PROXY = os.path.expanduser("~/.stripeproxy")
COOKIE_FILE = os.path.expanduser("~/.jira.d/cookies.js")

JQL = (
    'project = RUN_TERMINAL_SDK AND '
    'status not in (Done, Resolved, "Won\'t Fix", "Won\'t Do", '
    '"Closed", "Review Complete", "Review Passed", "Canceled") '
    "ORDER BY updated ASC"
)

STATUS_PRIORITY = {
    "needs triage": 0,
    "in progress": 1,
}


def _status_sort_key(ticket):
    priority = STATUS_PRIORITY.get(ticket["status"].lower(), 99)
    return (priority, ticket["updated"])

_comment_cache = {}


class UnixHTTPConnection(http.client.HTTPConnection):
    def __init__(self, unix_socket, host):
        super().__init__(host)
        self.unix_socket = unix_socket

    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.connect(self.unix_socket)


def load_cookies():
    with open(COOKIE_FILE) as f:
        cookies = json.load(f)
    return "; ".join(f'{c["Name"]}={c["Value"]}' for c in cookies)


def jira_request(method, path, body=None):
    conn = UnixHTTPConnection(UNIX_PROXY, JIRA_HOST)
    headers = {
        "Host": JIRA_HOST,
        "Cookie": load_cookies(),
        "Content-Type": "application/json",
    }
    conn.request(method, path, body=body, headers=headers)
    resp = conn.getresponse()
    resp_body = resp.read()
    if resp.status not in (200, 201, 204):
        raise RuntimeError(f"Jira API {resp.status}: {resp_body.decode()}")
    if resp_body:
        return json.loads(resp_body)
    return None


def jira_get(path):
    return jira_request("GET", path)


def jira_post(path, data):
    return jira_request("POST", path, body=json.dumps(data).encode())


def jira_put(path, data):
    return jira_request("PUT", path, body=json.dumps(data).encode())


def assign_ticket(ticket_key, username="billfinn"):
    jira_put(f"/rest/api/2/issue/{ticket_key}", {"fields": {"assignee": {"name": username}}})


def get_transitions(ticket_key):
    return jira_get(f"/rest/api/2/issue/{ticket_key}/transitions")


def transition_to_done(ticket_key, comment=None):
    transitions = get_transitions(ticket_key)
    done_id = None
    for t in transitions.get("transitions", []):
        if t["name"].lower() in ("done", "resolved", "close"):
            done_id = t["id"]
            break
    if not done_id:
        available = [t["name"] for t in transitions.get("transitions", [])]
        raise RuntimeError(f"No 'Done' transition found. Available: {available}")
    payload = {"transition": {"id": done_id}}
    if comment:
        payload["update"] = {"comment": [{"add": {"body": comment}}]}
    jira_post(f"/rest/api/2/issue/{ticket_key}/transitions", payload)


def fetch_tickets():
    tickets = []
    start = 0
    batch = 100
    while True:
        params = urllib.parse.urlencode({
            "jql": JQL,
            "startAt": start,
            "maxResults": batch,
            "fields": "key,summary,description,status,issuetype,assignee,updated",
        })
        data = jira_get(f"/rest/api/2/search?{params}")
        for issue in data.get("issues", []):
            f = issue["fields"]
            desc = f.get("description") or "(no description)"
            desc = desc.replace("\r\n", "\n").replace("\r", "\n")
            assignee_obj = f.get("assignee")
            assignee = assignee_obj.get("displayName", "Unassigned") if assignee_obj else "Unassigned"
            tickets.append({
                "key": issue["key"],
                "summary": f.get("summary", ""),
                "description": desc,
                "status": f.get("status", {}).get("name", ""),
                "type": f.get("issuetype", {}).get("name", ""),
                "assignee": assignee,
                "updated": f.get("updated", "")[:10],
            })
        if start + batch >= data.get("total", 0):
            break
        start += batch
    tickets.sort(key=_status_sort_key)
    return tickets


def fetch_comments(ticket_key):
    data = jira_get(f"/rest/api/2/issue/{ticket_key}/comment")
    comments = []
    for c in data.get("comments", []):
        body = (c.get("body") or "").replace("\r\n", "\n").replace("\r", "\n")
        comments.append({
            "author": c.get("author", {}).get("displayName", "Unknown"),
            "created": c.get("created", "")[:10],
            "body": body,
        })
    return comments


def fetch_comments_async(ticket_key, result_holder):
    try:
        comments = fetch_comments(ticket_key)
        _comment_cache[ticket_key] = comments
        result_holder["comments"] = comments
    except Exception as e:
        result_holder["error"] = str(e)
    result_holder["done"] = True


def add_comment(ticket_key, comment_body):
    jira_post(f"/rest/api/2/issue/{ticket_key}/comment", {"body": comment_body})


def open_in_browser(ticket_key):
    import webbrowser
    webbrowser.open(f"https://go/jira/{ticket_key}")


def draw_list(stdscr, tickets, cursor, scroll_offset, selected=None):
    if selected is None:
        selected = set()
    height, width = stdscr.getmaxyx()
    header_lines = 2
    footer_lines = 3
    list_height = height - header_lines - footer_lines

    sel_info = f"  ({len(selected)} selected)" if selected else ""
    title = f" RUN_TERMINAL_SDK — {len(tickets)} open ticket(s){sel_info} "
    stdscr.attron(curses.A_BOLD)
    stdscr.addnstr(0, 0, title.center(width), width)
    stdscr.attroff(curses.A_BOLD)

    if not tickets:
        stdscr.addnstr(2, 2, "No open tickets found.", width - 4)
        return

    key_width = max(len(t["key"]) for t in tickets)
    status_width = min(20, max(len(t["status"]) for t in tickets))
    type_width = max(len(t["type"]) for t in tickets)
    assignee_width = min(20, max(len(t["assignee"]) for t in tickets))

    for i in range(list_height):
        idx = scroll_offset + i
        row = header_lines + i
        if idx >= len(tickets):
            stdscr.move(row, 0)
            stdscr.clrtoeol()
            continue

        t = tickets[idx]
        mark = "*" if idx in selected else " "
        num = f" {mark} {idx + 1:>4}. "
        key_part = f"{t['key']:<{key_width}}"
        status = t["status"][:status_width]
        status_part = f"  {status:<{status_width}}"
        type_part = f"  {t['type']:<{type_width}}"
        assignee = t["assignee"][:assignee_width]
        assignee_part = f"  {assignee:<{assignee_width}}"
        prefix = num + key_part + status_part + type_part + assignee_part + "  "
        summary_space = max(0, width - len(prefix) - 1)
        summary = t["summary"][:summary_space]
        line = prefix + summary

        if idx == cursor:
            stdscr.attron(curses.color_pair(1))
            stdscr.addnstr(row, 0, line.ljust(width - 1), width - 1)
            stdscr.attroff(curses.color_pair(1))
        else:
            stdscr.addnstr(row, 0, line.ljust(width - 1), width - 1)

    help_row = height - 2
    help_text = " [Space] select  [Enter] view  [m] comment  [a] assign  [d] done  [v] browse  [r] refresh  [q] quit "
    stdscr.attron(curses.A_DIM)
    stdscr.addnstr(help_row, 0, help_text.center(width), width - 1)
    stdscr.attroff(curses.A_DIM)


def build_detail_lines(ticket, comments, content_width, loading=False, error=None):
    lines = []
    lines.append(f"{ticket['key']}: {ticket['summary']}")
    lines.append(f"Type: {ticket['type']}  |  Status: {ticket['status']}  |  Assignee: {ticket['assignee']}")
    lines.append(f"Updated: {ticket['updated']}  |  https://go/jira/{ticket['key']}")
    lines.append("")
    for paragraph in ticket["description"].split("\n"):
        if paragraph.strip():
            lines.extend(textwrap.wrap(paragraph, width=content_width))
        else:
            lines.append("")

    lines.append("")
    lines.append("=" * min(content_width, 60))

    if loading:
        lines.append("")
        lines.append("Loading comments...")
    elif error:
        lines.append("")
        lines.append(f"Error loading comments: {error}")
    elif comments is not None:
        if not comments:
            lines.append("")
            lines.append("(no comments)")
        else:
            for c in comments:
                lines.append("")
                lines.append(f"{c['author']}  ({c['created']})")
                lines.append("-" * min(content_width, 40))
                for paragraph in c["body"].split("\n"):
                    if paragraph.strip():
                        lines.extend(textwrap.wrap(paragraph, width=content_width))
                    else:
                        lines.append("")

    return lines


def render_detail(stdscr, lines, scroll, width, height):
    viewable = height - 2
    stdscr.clear()
    for i in range(viewable):
        li = scroll + i
        if li >= len(lines):
            break
        try:
            stdscr.addnstr(i, 2, lines[li], width - 3)
        except curses.error:
            pass

    help_text = " [j/k] prev/next  [m] comment  [a] assign  [d] done  [v] browse  [r] refresh  [Enter/q] back "
    stdscr.attron(curses.A_DIM)
    try:
        stdscr.addnstr(height - 1, 0, help_text.center(width), width - 1)
    except curses.error:
        pass
    stdscr.attroff(curses.A_DIM)
    stdscr.refresh()


def _init_detail_state(ticket, content_width):
    cached = _comment_cache.get(ticket["key"])
    if cached is not None:
        lines = build_detail_lines(ticket, cached, content_width)
        return lines, False, {"done": True}
    else:
        result_holder = {"done": False}
        thread = threading.Thread(
            target=fetch_comments_async,
            args=(ticket["key"], result_holder),
            daemon=True,
        )
        thread.start()
        lines = build_detail_lines(ticket, None, content_width, loading=True)
        return lines, True, result_holder


def prompt_for_comment(stdscr):
    """Drop out of curses to prompt for multiline comment text."""
    curses.endwin()
    print("Enter comment (empty line to cancel, Ctrl-D or two blank lines to submit):")
    lines = []
    blank_count = 0
    try:
        while True:
            line = input()
            if line == "" and not lines:
                return None
            if line == "":
                blank_count += 1
                if blank_count >= 2:
                    break
                lines.append("")
            else:
                blank_count = 0
                lines.append(line)
    except EOFError:
        pass
    text = "\n".join(lines).strip()
    return text if text else None


def show_description_screen(stdscr, tickets, cursor):
    height, width = stdscr.getmaxyx()
    content_width = min(width - 4, 100)
    scroll = 0
    spinner_frames = ["|", "/", "-", "\\"]
    spinner_idx = 0

    ticket = tickets[cursor]
    lines, loading, result_holder = _init_detail_state(ticket, content_width)

    stdscr.timeout(150 if loading else -1)

    while True:
        if not tickets:
            stdscr.timeout(-1)
            return tickets, 0

        height, width = stdscr.getmaxyx()
        content_width = min(width - 4, 100)
        viewable = height - 2

        if loading and result_holder.get("done"):
            loading = False
            stdscr.timeout(-1)
            comments = result_holder.get("comments")
            error = result_holder.get("error")
            lines = build_detail_lines(ticket, comments, content_width, error=error)

        if loading:
            spinner_idx = (spinner_idx + 1) % len(spinner_frames)
            for li, line in enumerate(lines):
                if line.startswith("Loading comments"):
                    lines[li] = f"Loading comments... {spinner_frames[spinner_idx]}"
                    break

        render_detail(stdscr, lines, scroll, width, height)

        key = stdscr.getch()
        if key == -1:
            continue

        if key == curses.KEY_DOWN:
            if scroll < max(0, len(lines) - viewable):
                scroll += 1
        elif key == curses.KEY_UP:
            if scroll > 0:
                scroll -= 1
        elif key == curses.KEY_NPAGE:
            scroll = min(scroll + viewable, max(0, len(lines) - viewable))
        elif key == curses.KEY_PPAGE:
            scroll = max(scroll - viewable, 0)

        elif key == ord("j"):
            if cursor < len(tickets) - 1:
                cursor += 1
                ticket = tickets[cursor]
                scroll = 0
                lines, loading, result_holder = _init_detail_state(ticket, content_width)
                stdscr.timeout(150 if loading else -1)

        elif key == ord("k"):
            if cursor > 0:
                cursor -= 1
                ticket = tickets[cursor]
                scroll = 0
                lines, loading, result_holder = _init_detail_state(ticket, content_width)
                stdscr.timeout(150 if loading else -1)

        elif key == ord("m"):
            comment_text = prompt_for_comment(stdscr)
            stdscr = _restore_curses()
            if comment_text:
                try:
                    add_comment(ticket["key"], comment_text)
                    _comment_cache.pop(ticket["key"], None)
                    show_message(stdscr, f"Comment added to {ticket['key']}.")
                except Exception as e:
                    show_message(stdscr, f"Failed to add comment: {e}")
                lines, loading, result_holder = _init_detail_state(ticket, content_width)
                stdscr.timeout(150 if loading else -1)

        elif key == ord("a"):
            try:
                with_status(stdscr, f"Assigning {ticket['key']}...", lambda: assign_ticket(ticket["key"]))
                show_message(stdscr, f"Assigned {ticket['key']} to billfinn.")
                tickets = with_status(stdscr, "Refreshing...", fetch_tickets)
                cursor = min(cursor, max(0, len(tickets) - 1))
                if not tickets:
                    stdscr.timeout(-1)
                    return tickets, cursor
                ticket = tickets[cursor]
                scroll = 0
                lines, loading, result_holder = _init_detail_state(ticket, content_width)
                stdscr.timeout(150 if loading else -1)
            except Exception as e:
                show_message(stdscr, f"Failed to assign: {e}")

        elif key == ord("d"):
            comment_text = prompt_for_comment(stdscr)
            stdscr = _restore_curses()
            if comment_text:
                try:
                    with_status(stdscr, f"Closing {ticket['key']}...", lambda: transition_to_done(ticket["key"], comment=comment_text))
                    show_message(stdscr, f"{ticket['key']} moved to Done.")
                    tickets = with_status(stdscr, "Refreshing...", fetch_tickets)
                    cursor = min(cursor, max(0, len(tickets) - 1))
                    if not tickets:
                        stdscr.timeout(-1)
                        return tickets, cursor
                    ticket = tickets[cursor]
                    scroll = 0
                    lines, loading, result_holder = _init_detail_state(ticket, content_width)
                    stdscr.timeout(150 if loading else -1)
                except Exception as e:
                    show_message(stdscr, f"Failed to transition: {e}")

        elif key == ord("v"):
            open_in_browser(ticket["key"])

        elif key == ord("r"):
            loading = True
            _comment_cache.pop(ticket["key"], None)
            result_holder = {"done": False}
            lines = build_detail_lines(ticket, None, content_width, loading=True)
            thread = threading.Thread(
                target=fetch_comments_async,
                args=(ticket["key"], result_holder),
                daemon=True,
            )
            thread.start()
            stdscr.timeout(150)

        elif key in (ord("q"), ord("\n"), 27):
            stdscr.timeout(-1)
            return tickets, cursor


def show_status(stdscr, msg):
    height, width = stdscr.getmaxyx()
    stdscr.move(height - 1, 0)
    stdscr.clrtoeol()
    stdscr.attron(curses.A_BOLD)
    stdscr.addnstr(height - 1, 0, f" {msg}", width - 1)
    stdscr.attroff(curses.A_BOLD)
    stdscr.refresh()


def with_status(stdscr, msg, fn):
    """Run fn() while showing a status message. Returns fn's result."""
    height, width = stdscr.getmaxyx()
    spinner = ["|", "/", "-", "\\"]
    result = {}

    def _run():
        try:
            result["value"] = fn()
        except Exception as e:
            result["error"] = e

    t = threading.Thread(target=_run, daemon=True)
    t.start()
    idx = 0
    while t.is_alive():
        frame = spinner[idx % len(spinner)]
        stdscr.move(height - 1, 0)
        stdscr.clrtoeol()
        stdscr.attron(curses.A_BOLD)
        stdscr.addnstr(height - 1, 0, f" {frame} {msg}", width - 1)
        stdscr.attroff(curses.A_BOLD)
        stdscr.refresh()
        t.join(timeout=0.12)
        idx += 1
    stdscr.move(height - 1, 0)
    stdscr.clrtoeol()
    stdscr.refresh()
    if "error" in result:
        raise result["error"]
    return result.get("value")


def show_message(stdscr, msg):
    height, width = stdscr.getmaxyx()
    stdscr.move(height - 1, 0)
    stdscr.clrtoeol()
    stdscr.addnstr(height - 1, 0, msg + "  [press any key]", width - 1)
    stdscr.refresh()
    stdscr.getch()


def _restore_curses():
    stdscr = curses.initscr()
    curses.noecho()
    curses.cbreak()
    stdscr.keypad(True)
    curses.curs_set(0)
    return stdscr


def curses_main(stdscr):
    curses.curs_set(0)
    curses.use_default_colors()
    curses.init_pair(1, curses.COLOR_BLACK, curses.COLOR_CYAN)

    tickets = with_status(stdscr, "Fetching RUN_TERMINAL_SDK tickets...", fetch_tickets)
    cursor = 0
    scroll_offset = 0
    selected = set()

    while True:
        height, width = stdscr.getmaxyx()
        header_lines = 2
        footer_lines = 3
        list_height = height - header_lines - footer_lines

        if tickets:
            cursor = max(0, min(cursor, len(tickets) - 1))
            if cursor < scroll_offset:
                scroll_offset = cursor
            elif cursor >= scroll_offset + list_height:
                scroll_offset = cursor - list_height + 1
        else:
            cursor = 0
            scroll_offset = 0

        stdscr.clear()
        draw_list(stdscr, tickets, cursor, scroll_offset, selected)
        stdscr.refresh()

        key = stdscr.getch()

        if key == curses.KEY_UP or key == ord("k"):
            if cursor > 0:
                cursor -= 1

        elif key == curses.KEY_DOWN or key == ord("j"):
            if cursor < len(tickets) - 1:
                cursor += 1

        elif key == curses.KEY_PPAGE:
            cursor = max(0, cursor - list_height)

        elif key == curses.KEY_NPAGE:
            cursor = min(len(tickets) - 1, cursor + list_height)

        elif key == ord("g"):
            cursor = 0

        elif key == ord("G"):
            cursor = len(tickets) - 1

        elif key == ord(" "):
            if tickets:
                if cursor in selected:
                    selected.discard(cursor)
                else:
                    selected.add(cursor)
                if cursor < len(tickets) - 1:
                    cursor += 1

        elif key == ord("\n"):
            if tickets:
                tickets, cursor = show_description_screen(stdscr, tickets, cursor)
                selected.clear()

        elif key == ord("m"):
            if tickets:
                ticket = tickets[cursor]
                comment_text = prompt_for_comment(stdscr)
                stdscr = _restore_curses()
                if comment_text:
                    try:
                        add_comment(ticket["key"], comment_text)
                        _comment_cache.pop(ticket["key"], None)
                        show_message(stdscr, f"Comment added to {ticket['key']}.")
                    except Exception as e:
                        show_message(stdscr, f"Failed to add comment: {e}")

        elif key == ord("a"):
            if tickets:
                targets = [tickets[i] for i in sorted(selected)] if selected else [tickets[cursor]]
                failed = []
                for i, t in enumerate(targets):
                    try:
                        with_status(stdscr, f"Assigning {t['key']} ({i+1}/{len(targets)})...", lambda tk=t["key"]: assign_ticket(tk))
                    except Exception as e:
                        failed.append((t["key"], e))
                if failed:
                    show_message(stdscr, f"Failed to assign {len(failed)}/{len(targets)} ticket(s).")
                else:
                    keys = ", ".join(t["key"] for t in targets)
                    show_message(stdscr, f"Assigned {keys} to billfinn.")
                selected.clear()
                tickets = with_status(stdscr, "Refreshing...", fetch_tickets)
                cursor = min(cursor, max(0, len(tickets) - 1))
                scroll_offset = 0

        elif key == ord("d"):
            if tickets:
                targets = [tickets[i] for i in sorted(selected)] if selected else [tickets[cursor]]
                n = len(targets)
                keys_preview = ", ".join(t["key"] for t in targets[:5])
                if n > 5:
                    keys_preview += f" (+{n - 5} more)"
                curses.endwin()
                print(f"Moving to Done: {keys_preview}")
                comment_text = prompt_for_comment(stdscr)
                stdscr = _restore_curses()
                if comment_text:
                    failed = []
                    for i, t in enumerate(targets):
                        try:
                            with_status(stdscr, f"Closing {t['key']} ({i+1}/{n})...", lambda tk=t["key"]: transition_to_done(tk, comment=comment_text))
                        except Exception as e:
                            failed.append((t["key"], e))
                    if failed:
                        show_message(stdscr, f"Done with errors: {len(failed)}/{n} failed.")
                    else:
                        show_message(stdscr, f"{n} ticket(s) moved to Done.")
                    selected.clear()
                    tickets = with_status(stdscr, "Refreshing...", fetch_tickets)
                    cursor = min(cursor, max(0, len(tickets) - 1))
                    scroll_offset = 0
                else:
                    selected.clear()

        elif key == ord("v"):
            if tickets:
                open_in_browser(tickets[cursor]["key"])

        elif key == ord("r"):
            tickets = with_status(stdscr, "Refreshing...", fetch_tickets)
            cursor = 0
            scroll_offset = 0
            selected.clear()

        elif key == ord("q"):
            break


def main():
    curses.wrapper(curses_main)


if __name__ == "__main__":
    main()
