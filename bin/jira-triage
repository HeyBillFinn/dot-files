#!/usr/bin/env python3
"""Interactive triage tool for Jira tickets with multiple views."""

import curses
import http.client
import json
import os
import re
import socket
import subprocess
import sys
import textwrap
import threading
import urllib.parse

JIRA_USER = os.environ.get("JIRA_USER", "billfinn")
JIRA_HOST = "jira.corp.stripe.com"
UNIX_PROXY = os.path.expanduser("~/.stripeproxy")
COOKIE_FILE = os.path.expanduser("~/.jira.d/cookies.js")
RANK_FIELD_ID = os.environ.get("JIRA_RANK_FIELD_ID")

STATUS_EXCLUSION = (
    'status not in (Done, Resolved, "Won\'t Fix", "Won\'t Do", '
    '"Closed", "Review Complete", "Review Passed", "Canceled")'
)

COLUMN_MAX_WIDTH = {
    "epic": 25,
    "rank": 10,
    "component": 20,
    "status": 20,
    "assignee": 20,
    "reporter": 20,
}

DEFAULT_COLUMNS = ["key", "component", "status", "type", "assignee", "summary"]

MODES = {
    "reported": {
        "title": "My Reported Tickets",
        "jql": (
            f"reporter = {JIRA_USER} AND {STATUS_EXCLUSION} "
            "ORDER BY updated DESC"
        ),
        "columns": ["key", "component", "status", "type", "summary"],
    },
    "assigned": {
        "title": "My Assigned Tickets",
        "jql": (
            f"assignee = {JIRA_USER} AND {STATUS_EXCLUSION} "
            'AND project not in ("Product Feedback", zSAF_ARCHIVE) '
            "ORDER BY updated DESC"
        ),
        "columns": ["key", "component", "status", "type", "summary"],
    },
    "run": {
        "title": "RUN_TERMINAL_SDK",
        "jql": (
            f"project = RUN_TERMINAL_SDK AND {STATUS_EXCLUSION} "
            "ORDER BY updated DESC"
        ),
        "columns": ["key", "component", "status", "type", "assignee", "summary"],
    },
    "commercex": {
        "title": "CommerceX (TERMINAL)",
        "jql": (
            f'project = TERMINAL AND component = "team:commercex" AND {STATUS_EXCLUSION} '
            "ORDER BY updated DESC"
        ),
        "columns": ["key", "epic", "status", "type", "assignee", "reporter", "summary"],
    },
}

SORTABLE_FIELDS = ["rank", "status", "updated", "component"]

_comment_cache = {}
_rank_field_id = RANK_FIELD_ID


class UnixHTTPConnection(http.client.HTTPConnection):
    def __init__(self, unix_socket, host):
        super().__init__(host)
        self.unix_socket = unix_socket

    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.connect(self.unix_socket)


def load_cookies():
    with open(COOKIE_FILE) as f:
        cookies = json.load(f)
    return "; ".join(f'{c["Name"]}={c["Value"]}' for c in cookies)


def jira_request(method, path, body=None, allowed_statuses=(200, 201, 204)):
    conn = UnixHTTPConnection(UNIX_PROXY, JIRA_HOST)
    headers = {
        "Host": JIRA_HOST,
        "Cookie": load_cookies(),
        "Content-Type": "application/json",
    }
    conn.request(method, path, body=body, headers=headers)
    resp = conn.getresponse()
    resp_body = resp.read()
    if resp.status not in allowed_statuses:
        raise RuntimeError(f"Jira API {resp.status}: {resp_body.decode()}")
    if resp_body:
        try:
            return json.loads(resp_body)
        except json.JSONDecodeError:
            return resp_body.decode()
    return None


def jira_get(path):
    return jira_request("GET", path)


def jira_post(path, data):
    return jira_request("POST", path, body=json.dumps(data).encode())


def jira_put(path, data):
    return jira_request("PUT", path, body=json.dumps(data).encode())


def jira_post_with_statuses(path, data, allowed_statuses):
    return jira_request(
        "POST",
        path,
        body=json.dumps(data).encode(),
        allowed_statuses=allowed_statuses,
    )


def jira_put_with_statuses(path, data, allowed_statuses):
    return jira_request(
        "PUT",
        path,
        body=json.dumps(data).encode(),
        allowed_statuses=allowed_statuses,
    )


def get_rank_field_id():
    global _rank_field_id
    if _rank_field_id:
        return _rank_field_id

    fields = jira_get("/rest/api/2/field")
    for field in fields:
        schema = field.get("schema") or {}
        if (
            field.get("name") == "Rank"
            or schema.get("custom") == "com.pyxis.greenhopper.jira:gh-lexo-rank"
        ):
            _rank_field_id = field.get("id")
            return _rank_field_id
    return None


def update_summary(ticket_key, summary):
    jira_put(f"/rest/api/2/issue/{ticket_key}", {"fields": {"summary": summary}})


def update_summary_async(ticket_key, summary, result_holder):
    try:
        update_summary(ticket_key, summary)
    except Exception as e:
        result_holder["error"] = str(e)
    result_holder["done"] = True


def update_epic_link(ticket_key, epic_key):
    jira_put(f"/rest/api/2/issue/{ticket_key}", {"fields": {"customfield_10002": epic_key}})


def update_epic_link_async(ticket_key, epic_key, result_holder):
    try:
        update_epic_link(ticket_key, epic_key)
    except Exception as e:
        result_holder["error"] = str(e)
    result_holder["done"] = True


def update_rank(ticket_key, target_key, placement):
    payload = {"issues": [ticket_key]}
    rank_field_id = get_rank_field_id()
    if rank_field_id:
        payload["rankCustomFieldId"] = int(rank_field_id.replace("customfield_", ""))
    if placement == "after":
        payload["rankAfterIssue"] = target_key
    else:
        payload["rankBeforeIssue"] = target_key
    result = jira_put_with_statuses("/rest/agile/1.0/issue/rank", payload, (204, 207))
    if result:
        if isinstance(result, str):
            raise RuntimeError(result)
        raise RuntimeError(json.dumps(result))


def update_rank_async(ticket_key, target_key, placement, result_holder):
    try:
        update_rank(ticket_key, target_key, placement)
    except Exception as e:
        result_holder["error"] = str(e)
    result_holder["done"] = True


def get_transitions(ticket_key):
    return jira_get(f"/rest/api/2/issue/{ticket_key}/transitions")


def transition_to(ticket_key, target_names, comment=None):
    transitions = get_transitions(ticket_key)
    target_id = None
    for t in transitions.get("transitions", []):
        if t["name"].lower() in [n.lower() for n in target_names]:
            target_id = t["id"]
            break
    if not target_id:
        available = [t["name"] for t in transitions.get("transitions", [])]
        raise RuntimeError(f"No matching transition found. Available: {available}")
    payload = {"transition": {"id": target_id}}
    if comment and comment.strip():
        payload["update"] = {"comment": [{"add": {"body": comment}}]}
    jira_post(f"/rest/api/2/issue/{ticket_key}/transitions", payload)


def transition_done(ticket_key, comment=None):
    transition_to(ticket_key, ["Done", "Resolved", "Close"], comment=comment)


def transition_wontfix(ticket_key, comment=None):
    transition_to(ticket_key, ["Won't Fix", "Won't Do"], comment=comment)


def transition_backlog(ticket_key, comment=None):
    transition_to(ticket_key, ["Backlog", "To Do", "Open"], comment=comment)


def assign_ticket(ticket_key, username="billfinn"):
    jira_put(f"/rest/api/2/issue/{ticket_key}", {"fields": {"assignee": {"name": username}}})


def assign_ticket_async(ticket_key, username, result_holder):
    try:
        assign_ticket(ticket_key, username)
    except Exception as e:
        result_holder["error"] = str(e)
    result_holder["done"] = True


def search_assignable_users(issue_key, query):
    def _fetch(param_name):
        params = urllib.parse.urlencode({
            "issueKey": issue_key,
            param_name: query,
            "maxResults": 20,
        })
        return jira_get(f"/rest/api/2/user/assignable/search?{params}")

    try:
        users = _fetch("username")
    except Exception:
        users = _fetch("query")
    if not isinstance(users, list):
        return []
    return [
        user.get("name") or user.get("key")
        for user in users
        if user.get("name") or user.get("key")
    ]


def _assignee_completer(issue_key, candidates):
    local_candidates = sorted({
        c for c in [JIRA_USER, *(candidates or [])]
        if c and c != "Unassigned"
    })
    cache = {}

    def _matches(text):
        normalized = text.lower()
        matches = [
            c for c in local_candidates
            if c.lower().startswith(normalized)
        ]
        if issue_key and text:
            remote_key = text.lower()
            if remote_key not in cache:
                try:
                    cache[remote_key] = search_assignable_users(issue_key, text)
                except Exception:
                    cache[remote_key] = []
            matches.extend(
                c for c in cache[remote_key]
                if c.lower().startswith(normalized)
            )
        return sorted(set(matches))

    def _complete(text, state):
        matches = _matches(text)
        if state < len(matches):
            return matches[state]
        return None

    return _complete


def prompt_for_assignee(stdscr, issue_key=None, candidates=None):
    """Prompt for assignee username, prefilled with JIRA_USER. Returns username or None if cancelled."""
    curses.endwin()
    try:
        import readline

        old_completer = readline.get_completer()
        old_delims = readline.get_completer_delims()
        readline.set_completer(_assignee_completer(issue_key, candidates))
        readline.set_completer_delims(" \t\n")
        if readline.__doc__ and "libedit" in readline.__doc__:
            readline.parse_and_bind("bind ^I rl_complete")
        else:
            readline.parse_and_bind("tab: complete")
        try:
            username = input(f"Assignee [{JIRA_USER}]: ").strip()
        finally:
            readline.set_completer(old_completer)
            readline.set_completer_delims(old_delims)
    except ImportError:
        try:
            username = input(f"Assignee [{JIRA_USER}]: ").strip()
        except (KeyboardInterrupt, EOFError):
            print()
            return None
    except (KeyboardInterrupt, EOFError):
        print()
        return None
    return username if username else JIRA_USER


def prompt_for_summary(stdscr, ticket):
    """Prompt for a replacement summary. Returns summary, "" for no-op, or None if cancelled."""
    curses.endwin()
    prompt = f"{ticket['key']} summary: "
    current_summary = ticket["summary"]
    try:
        import readline

        readline.set_startup_hook(lambda: readline.insert_text(current_summary))
        try:
            summary = input(prompt).strip()
        finally:
            readline.set_startup_hook()
    except ImportError:
        print(f"{ticket['key']} current summary:")
        print(current_summary)
        try:
            summary = input("New summary (blank to keep, Ctrl-C to cancel): ").strip()
        except (KeyboardInterrupt, EOFError):
            print()
            return None
    except (KeyboardInterrupt, EOFError):
        print()
        return None
    return summary


def prompt_for_epic_link(stdscr, ticket):
    """Prompt for a replacement epic key. Returns key, "" to clear, or None if cancelled."""
    curses.endwin()
    prompt = f"{ticket['key']} epic key (blank to clear): "
    current_epic_key = ticket.get("epic_key", "")
    try:
        import readline

        readline.set_startup_hook(lambda: readline.insert_text(current_epic_key))
        try:
            epic_key = input(prompt).strip().upper()
        finally:
            readline.set_startup_hook()
    except ImportError:
        print(f"{ticket['key']} current epic: {current_epic_key or '(none)'}")
        try:
            epic_key = input("New epic key (blank to clear, Ctrl-C to cancel): ").strip().upper()
        except (KeyboardInterrupt, EOFError):
            print()
            return None
    except (KeyboardInterrupt, EOFError):
        print()
        return None
    return epic_key


def add_comment(ticket_key, comment_body):
    comment_body = re.sub(r"@(\w+)", r"[~\1]", comment_body)
    jira_post(f"/rest/api/2/issue/{ticket_key}/comment", {"body": comment_body})


def _resolve_epic_names(epic_keys):
    """Resolve epic ticket keys to their summary (name)."""
    names = {}
    keys_list = list(epic_keys)
    for i in range(0, len(keys_list), 50):
        batch = keys_list[i:i+50]
        jql = "key in (" + ",".join(batch) + ")"
        params = urllib.parse.urlencode({
            "jql": jql,
            "maxResults": len(batch),
            "fields": "key,summary,customfield_10004",
        })
        try:
            data = jira_get(f"/rest/api/2/search?{params}")
            for issue in data.get("issues", []):
                f = issue["fields"]
                name = f.get("customfield_10004") or f.get("summary") or issue["key"]
                names[issue["key"]] = name
        except Exception:
            pass
    return names


def fetch_tickets(mode_config):
    tickets = []
    start = 0
    batch = 100
    try:
        rank_field_id = get_rank_field_id()
    except Exception:
        rank_field_id = None
    fields = [
        "key",
        "summary",
        "description",
        "status",
        "issuetype",
        "assignee",
        "reporter",
        "updated",
        "components",
        "customfield_10002",
        "customfield_10004",
    ]
    if rank_field_id:
        fields.append(rank_field_id)
    while True:
        params = urllib.parse.urlencode({
            "jql": mode_config["jql"],
            "startAt": start,
            "maxResults": batch,
            "fields": ",".join(fields),
        })
        data = jira_get(f"/rest/api/2/search?{params}")
        for issue in data.get("issues", []):
            f = issue["fields"]
            desc = f.get("description") or "(no description)"
            desc = desc.replace("\r\n", "\n").replace("\r", "\n")
            assignee_obj = f.get("assignee")
            assignee = assignee_obj.get("name", "Unassigned") if assignee_obj else "Unassigned"
            reporter_obj = f.get("reporter")
            reporter = reporter_obj.get("displayName", "") if reporter_obj else ""
            components = [c.get("name", "") for c in f.get("components", [])]
            component = ", ".join(components) if components else ""
            epic_key = f.get("customfield_10002") or ""
            tickets.append({
                "key": issue["key"],
                "summary": f.get("summary", ""),
                "description": desc,
                "status": f.get("status", {}).get("name", ""),
                "type": f.get("issuetype", {}).get("name", ""),
                "component": component,
                "epic": epic_key,
                "epic_key": epic_key,
                "rank": f.get(rank_field_id, "") if rank_field_id else "",
                "assignee": assignee,
                "reporter": reporter,
                "updated": f.get("updated", "")[:10],
            })
        if start + batch >= data.get("total", 0):
            break
        start += batch

    epic_keys = set(t["epic"] for t in tickets if t["epic"])
    if epic_keys:
        epic_names = _resolve_epic_names(epic_keys)
        for t in tickets:
            if t["epic"] in epic_names:
                t["epic"] = epic_names[t["epic"]]

    return tickets


def fetch_comments(ticket_key):
    data = jira_get(f"/rest/api/2/issue/{ticket_key}/comment")
    comments = []
    for c in data.get("comments", []):
        body = (c.get("body") or "").replace("\r\n", "\n").replace("\r", "\n")
        comments.append({
            "author": c.get("author", {}).get("displayName", "Unknown"),
            "created": c.get("created", "")[:10],
            "body": body,
        })
    return comments


def fetch_comments_async(ticket_key, result_holder):
    try:
        comments = fetch_comments(ticket_key)
        _comment_cache[ticket_key] = comments
        result_holder["comments"] = comments
    except Exception as e:
        result_holder["error"] = str(e)
    result_holder["done"] = True


def open_in_browser(ticket_key):
    import webbrowser
    webbrowser.open(f"https://go/jira/{ticket_key}")


def sort_tickets(tickets, sort_field, sort_reverse, columns):
    if not sort_field:
        return tickets
    if sort_field == "component" and "component" not in columns:
        return tickets
    if sort_field == "rank":
        return sorted(tickets, key=lambda t: t.get("rank_override") or t.get("rank") or "~", reverse=sort_reverse)
    return sorted(tickets, key=lambda t: t.get(sort_field, "").lower(), reverse=sort_reverse)


def filter_tickets_by_assignee(tickets, assignee_filter):
    if assignee_filter:
        return [t for t in tickets if t.get("assignee") == assignee_filter]
    return tickets


def assignee_filter_values(tickets):
    assignees = {
        t.get("assignee") or "Unassigned"
        for t in tickets
    }
    return sorted(assignees, key=lambda a: (a != JIRA_USER, a != "Unassigned", a.lower()))


def next_assignee_filter(tickets, assignee_filter):
    values = [None] + assignee_filter_values(tickets)
    if not values:
        return None
    try:
        idx = values.index(assignee_filter)
    except ValueError:
        return None
    return values[(idx + 1) % len(values)]


def assignee_filter_label(assignee_filter):
    return f"assignee={assignee_filter}" if assignee_filter else None


def assignee_candidates(tickets):
    return [t.get("assignee") for t in tickets]


def draw_list(stdscr, tickets, cursor, scroll_offset, mode_config, selected=None, sort_field=None, sort_reverse=False, filter_info=None, pending_rank_key=None):
    if selected is None:
        selected = set()
    height, width = stdscr.getmaxyx()
    header_lines = 3
    footer_lines = 3
    list_height = height - header_lines - footer_lines

    sel_info = f"  ({len(selected)} selected)" if selected else ""
    rank_info = "  [rank move pending]" if pending_rank_key else ""
    sort_info = ""
    if sort_field:
        arrow = "▼" if sort_reverse else "▲"
        sort_info = f"  [sort: {sort_field} {arrow}]"
    filter_str = f"  [filter: {filter_info}]" if filter_info else ""
    title = f" {mode_config['title']} — {len(tickets)} open ticket(s){sel_info}{sort_info}{filter_str}{rank_info} "
    stdscr.attron(curses.A_BOLD)
    stdscr.addnstr(0, 0, title.center(width), width)
    stdscr.attroff(curses.A_BOLD)

    if not tickets:
        stdscr.addnstr(3, 2, "No open tickets found.", width - 4)
        return

    columns = mode_config.get("columns", DEFAULT_COLUMNS)
    col_widths = {}
    for col in columns:
        if col in ("key", "summary"):
            continue
        max_cap = COLUMN_MAX_WIDTH.get(col, 30)
        col_widths[col] = min(max_cap, max((len(t.get(col, "")) for t in tickets), default=0))

    key_width = max(len(t["key"]) for t in tickets)

    col_headers = [f"{'#':>7}  ", f"{'KEY':<{key_width}}"]
    for col in columns:
        if col in ("key", "summary"):
            continue
        w = col_widths[col]
        if w == 0:
            continue
        col_headers.append(f"  {col.upper():<{w}}")
    col_headers.append("  SUMMARY")
    header_line = "".join(col_headers)
    stdscr.attron(curses.A_DIM)
    stdscr.addnstr(1, 0, header_line.ljust(width - 1), width - 1)
    stdscr.attroff(curses.A_DIM)

    for i in range(list_height):
        idx = scroll_offset + i
        row = header_lines + i
        if idx >= len(tickets):
            stdscr.move(row, 0)
            stdscr.clrtoeol()
            continue

        t = tickets[idx]
        rank_pending = t["key"] == pending_rank_key
        mark = ">" if rank_pending else "*" if idx in selected else " "
        parts = [f" {mark} {idx + 1:>4}. ", f"{t['key']:<{key_width}}"]
        for col in columns:
            if col in ("key", "summary"):
                continue
            w = col_widths[col]
            if w == 0:
                continue
            val = t.get(col, "")[:w]
            parts.append(f"  {val:<{w}}")
        prefix = "".join(parts) + "  "
        summary_space = max(0, width - len(prefix) - 1)
        summary = t["summary"][:summary_space]
        line = prefix + summary

        if rank_pending:
            attrs = curses.color_pair(2) | curses.A_BOLD
        elif idx == cursor:
            attrs = curses.color_pair(1)
        else:
            attrs = 0

        if attrs:
            stdscr.attron(attrs)
            stdscr.addnstr(row, 0, line.ljust(width - 1), width - 1)
            stdscr.attroff(attrs)
        else:
            stdscr.addnstr(row, 0, line.ljust(width - 1), width - 1)

    help_row = height - 2
    show_assign = "assignee" in columns
    rank_help = " [K/J] move rank  [Enter] save rank  [s/f/r] cancel" if pending_rank_key else " [K/J] move rank  [Enter] save rank" if sort_field == "rank" and not sort_reverse else " [Enter] view"
    if show_assign:
        help_text = f" [.] select {rank_help}  [e] summary  [E] epic  [m] comment  [a] assign  [b] backlog  [x] Won't Fix  [d] done  [s] sort  [f] filter  [v] browse  [r] refresh  [q] quit"
    else:
        help_text = f" [.] select {rank_help}  [e] summary  [E] epic  [m] comment  [b] backlog  [x] Won't Fix  [d] done  [s] sort  [f] filter  [v] browse  [r] refresh  [q] quit"
    stdscr.attron(curses.A_DIM)
    stdscr.addnstr(help_row, 0, help_text.center(width), width - 1)
    stdscr.attroff(curses.A_DIM)


def build_detail_lines(ticket, comments, content_width, loading=False, error=None):
    lines = []
    lines.append(f"{ticket['key']}: {ticket['summary']}")
    lines.append(f"Type: {ticket['type']}  |  Status: {ticket['status']}  |  Assignee: {ticket['assignee']}")
    if ticket.get("epic"):
        lines.append(f"Epic: {ticket['epic']}")
    if ticket.get("rank"):
        lines.append(f"Rank: {ticket['rank']}")
    lines.append(f"Updated: {ticket['updated']}  |  https://go/jira/{ticket['key']}")
    lines.append("")
    for paragraph in ticket["description"].split("\n"):
        if paragraph.strip():
            lines.extend(textwrap.wrap(paragraph, width=content_width))
        else:
            lines.append("")

    lines.append("")
    lines.append("=" * min(content_width, 60))

    if loading:
        lines.append("")
        lines.append("Loading comments...")
    elif error:
        lines.append("")
        lines.append(f"Error loading comments: {error}")
    elif comments is not None:
        if not comments:
            lines.append("")
            lines.append("(no comments)")
        else:
            for c in comments:
                lines.append("")
                lines.append(f"{c['author']}  ({c['created']})")
                lines.append("-" * min(content_width, 40))
                for paragraph in c["body"].split("\n"):
                    if paragraph.strip():
                        lines.extend(textwrap.wrap(paragraph, width=content_width))
                    else:
                        lines.append("")

    return lines


def render_detail(stdscr, lines, scroll, width, height, mode_config):
    viewable = height - 2
    stdscr.clear()
    for i in range(viewable):
        li = scroll + i
        if li >= len(lines):
            break
        try:
            stdscr.addnstr(i, 2, lines[li], width - 3)
        except curses.error:
            pass

    if "assignee" in mode_config.get("columns", DEFAULT_COLUMNS):
        help_text = " [j/k] prev/next  [e] summary  [E] epic  [m] comment  [a] assign  [b] backlog  [x] Won't Fix  [d] done  [v] browse  [r] refresh  [Enter/q] back"
    else:
        help_text = " [j/k] prev/next  [e] summary  [E] epic  [m] comment  [b] backlog  [x] Won't Fix  [d] done  [v] browse  [r] refresh  [Enter/q] back"
    stdscr.attron(curses.A_DIM)
    try:
        stdscr.addnstr(height - 1, 0, help_text.center(width), width - 1)
    except curses.error:
        pass
    stdscr.attroff(curses.A_DIM)
    stdscr.refresh()


def _init_detail_state(ticket, content_width):
    cached = _comment_cache.get(ticket["key"])
    if cached is not None:
        lines = build_detail_lines(ticket, cached, content_width)
        return lines, False, {"done": True}
    else:
        result_holder = {"done": False}
        thread = threading.Thread(
            target=fetch_comments_async,
            args=(ticket["key"], result_holder),
            daemon=True,
        )
        thread.start()
        lines = build_detail_lines(ticket, None, content_width, loading=True)
        return lines, True, result_holder


def prompt_for_comment(stdscr, header=None):
    """Prompt for a comment. Returns string (possibly empty) or None if cancelled (Ctrl-C)."""
    curses.endwin()
    if header:
        print(header)
    print("Enter comment (Enter to skip, Ctrl-C to cancel, two blank lines to submit):")
    lines = []
    blank_count = 0
    try:
        while True:
            line = input()
            if line == "" and not lines:
                return ""
            if line == "":
                blank_count += 1
                if blank_count >= 2:
                    break
                lines.append("")
            else:
                blank_count = 0
                lines.append(line)
    except EOFError:
        pass
    except KeyboardInterrupt:
        print()
        return None
    text = "\n".join(lines).strip()
    return text


def confirm_prompt(stdscr, msg):
    height, width = stdscr.getmaxyx()
    stdscr.move(height - 1, 0)
    stdscr.clrtoeol()
    stdscr.attron(curses.A_BOLD)
    stdscr.addnstr(height - 1, 0, msg, width - 1)
    stdscr.attroff(curses.A_BOLD)
    stdscr.refresh()
    key = stdscr.getch()
    return key not in (ord("n"), ord("N"))


def with_status(stdscr, msg, fn):
    height, width = stdscr.getmaxyx()
    spinner = ["|", "/", "-", "\\"]
    result = {}

    def _run():
        try:
            result["value"] = fn()
        except Exception as e:
            result["error"] = e

    t = threading.Thread(target=_run, daemon=True)
    t.start()
    idx = 0
    while t.is_alive():
        frame = spinner[idx % len(spinner)]
        stdscr.move(height - 1, 0)
        stdscr.clrtoeol()
        stdscr.attron(curses.A_BOLD)
        stdscr.addnstr(height - 1, 0, f" {frame} {msg}", width - 1)
        stdscr.attroff(curses.A_BOLD)
        stdscr.refresh()
        t.join(timeout=0.12)
        idx += 1
    stdscr.move(height - 1, 0)
    stdscr.clrtoeol()
    stdscr.refresh()
    if "error" in result:
        raise result["error"]
    return result.get("value")


def show_message(stdscr, msg):
    height, width = stdscr.getmaxyx()
    stdscr.timeout(-1)
    lines = textwrap.wrap(msg, width=max(20, width - 4)) or [""]
    lines.append("[press any key]")
    start_row = max(0, height - len(lines))
    for row in range(start_row, height):
        stdscr.move(row, 0)
        stdscr.clrtoeol()
    for i, line in enumerate(lines[-height:]):
        stdscr.addnstr(start_row + i, 0, line, width - 1)
    stdscr.refresh()
    stdscr.getch()


def start_summary_update(ticket, new_summary, update_jobs):
    if not new_summary or new_summary == ticket["summary"]:
        return False

    old_summary = ticket["summary"]
    ticket["summary"] = new_summary
    job = {
        "done": False,
        "label": "Summary update",
        "ticket_key": ticket["key"],
        "old_values": {"summary": old_summary},
        "new_values": {"summary": new_summary},
    }
    thread = threading.Thread(
        target=update_summary_async,
        args=(ticket["key"], new_summary, job),
        daemon=True,
    )
    thread.start()
    update_jobs.append(job)
    return True


def start_epic_link_update(ticket, new_epic_key, update_jobs):
    if new_epic_key is None:
        return False

    old_epic_key = ticket.get("epic_key", "")
    if new_epic_key == old_epic_key:
        return False

    old_epic = ticket.get("epic", "")
    ticket["epic_key"] = new_epic_key
    ticket["epic"] = new_epic_key
    job = {
        "done": False,
        "label": "Epic Link update",
        "ticket_key": ticket["key"],
        "old_values": {"epic_key": old_epic_key, "epic": old_epic},
        "new_values": {"epic_key": new_epic_key, "epic": new_epic_key},
    }
    thread = threading.Thread(
        target=update_epic_link_async,
        args=(ticket["key"], new_epic_key or None, job),
        daemon=True,
    )
    thread.start()
    update_jobs.append(job)
    return True


def start_assignee_update(ticket, username, update_jobs):
    if not username or username == ticket.get("assignee"):
        return False

    old_assignee = ticket.get("assignee", "Unassigned")
    ticket["assignee"] = username
    job = {
        "done": False,
        "label": "Assignee update",
        "ticket_key": ticket["key"],
        "old_values": {"assignee": old_assignee},
        "new_values": {"assignee": username},
    }
    thread = threading.Thread(
        target=assign_ticket_async,
        args=(ticket["key"], username, job),
        daemon=True,
    )
    thread.start()
    update_jobs.append(job)
    return True


def capture_rank_overrides(tickets):
    return {
        ticket["key"]: {"rank_override": ticket.get("rank_override")}
        for ticket in tickets
    }


def restore_rank_overrides(tickets, old_values_by_key):
    if not old_values_by_key:
        return
    for ticket in tickets:
        old_values = old_values_by_key.get(ticket["key"])
        if old_values is not None:
            restore_ticket_values(ticket, old_values)


def assign_local_rank_overrides(tickets):
    for idx, ticket in enumerate(tickets):
        ticket["rank_override"] = f"{idx:08d}"


def move_ranked_ticket(tickets, cursor, direction):
    new_cursor = cursor + direction
    if cursor < 0 or cursor >= len(tickets) or new_cursor < 0 or new_cursor >= len(tickets):
        return cursor, False

    ticket = tickets.pop(cursor)
    tickets.insert(new_cursor, ticket)
    assign_local_rank_overrides(tickets)
    return new_cursor, True


def rank_target_for_position(tickets, ticket_key):
    idx = find_ticket_index(tickets, ticket_key, None)
    if idx is None:
        return None, None
    if idx > 0:
        return tickets[idx - 1]["key"], "after"
    if idx + 1 < len(tickets):
        return tickets[idx + 1]["key"], "before"
    return None, None


def enqueue_rank_update(ticket, target_key, placement, update_jobs, old_values_by_key=None):
    if not target_key or target_key == ticket["key"]:
        return False

    job = {
        "done": False,
        "label": "Rank update",
        "ticket_key": ticket["key"],
        "old_values": (old_values_by_key or {}).get(ticket["key"], {"rank_override": ticket.get("rank_override")}),
        "new_values": {"rank_override": ticket.get("rank_override")},
        "old_values_by_key": old_values_by_key,
    }
    thread = threading.Thread(
        target=update_rank_async,
        args=(ticket["key"], target_key, placement, job),
        daemon=True,
    )
    thread.start()
    update_jobs.append(job)
    return True


def find_ticket_index(tickets, ticket_key, fallback):
    for i, ticket in enumerate(tickets):
        if ticket["key"] == ticket_key:
            return i
    if fallback is None:
        return None
    return min(fallback, max(0, len(tickets) - 1))


def restore_ticket_values(ticket, values):
    for field, value in values.items():
        if value is None:
            ticket.pop(field, None)
        else:
            ticket[field] = value


def restore_failed_updates(tickets, failed_jobs):
    by_key = {}
    for job in failed_jobs:
        by_key.setdefault(job["ticket_key"], []).append(job)
        restore_rank_overrides(tickets, job.get("old_values_by_key"))
    for ticket in tickets:
        for job in by_key.get(ticket["key"], []):
            new_values = job.get("new_values", {})
            if all(ticket.get(field) == value for field, value in new_values.items()):
                restore_ticket_values(ticket, job.get("old_values", {}))


def refresh_after_failed_update(stdscr, mode_config, tickets, cursor, current_key=None, failed_jobs=None):
    failed_label = failed_jobs[0].get("label", "Update") if failed_jobs else "Update"
    failed_error = failed_jobs[0].get("error") if failed_jobs else None
    try:
        tickets = with_status(
            stdscr,
            f"{failed_label} failed; refreshing...",
            lambda: fetch_tickets(mode_config),
        )
    except Exception as e:
        restore_failed_updates(tickets, failed_jobs or [])
        failure_details = f": {failed_error}" if failed_error else ""
        show_message(stdscr, f"{failed_label} failed{failure_details}; refresh failed: {e}")
        return tickets, cursor

    if current_key:
        cursor = find_ticket_index(tickets, current_key, cursor)
    else:
        cursor = min(cursor, max(0, len(tickets) - 1))
    failure_details = f": {failed_error}" if failed_error else ""
    show_message(stdscr, f"{failed_label} failed{failure_details}; refreshed from Jira.")
    return tickets, cursor


def completed_update_errors(update_jobs):
    errors = []
    pending = []
    for job in update_jobs:
        if not job.get("done"):
            pending.append(job)
        elif job.get("error"):
            errors.append(job)
    update_jobs[:] = pending
    return errors


def _restore_curses():
    stdscr = curses.initscr()
    curses.noecho()
    curses.cbreak()
    stdscr.keypad(True)
    curses.curs_set(0)
    return stdscr


def show_description_screen(stdscr, tickets, cursor, mode_config, update_jobs):
    height, width = stdscr.getmaxyx()
    content_width = min(width - 4, 100)
    scroll = 0
    spinner_frames = ["|", "/", "-", "\\"]
    spinner_idx = 0

    ticket = tickets[cursor]
    lines, loading, result_holder = _init_detail_state(ticket, content_width)

    stdscr.timeout(150 if loading else -1)

    while True:
        if not tickets:
            stdscr.timeout(-1)
            return tickets, 0

        height, width = stdscr.getmaxyx()
        content_width = min(width - 4, 100)
        viewable = height - 2

        if loading and result_holder.get("done"):
            loading = False
            stdscr.timeout(-1)
            comments = result_holder.get("comments")
            error = result_holder.get("error")
            lines = build_detail_lines(ticket, comments, content_width, error=error)

        if loading:
            spinner_idx = (spinner_idx + 1) % len(spinner_frames)
            for li, line in enumerate(lines):
                if line.startswith("Loading comments"):
                    lines[li] = f"Loading comments... {spinner_frames[spinner_idx]}"
                    break

        failed_jobs = completed_update_errors(update_jobs)
        if failed_jobs:
            stdscr.timeout(-1)
            tickets, cursor = refresh_after_failed_update(
                stdscr,
                mode_config,
                tickets,
                cursor,
                current_key=ticket["key"],
                failed_jobs=failed_jobs,
            )
            if not tickets:
                return tickets, cursor
            ticket = tickets[cursor]
            scroll = 0
            lines, loading, result_holder = _init_detail_state(ticket, content_width)
            stdscr.timeout(150 if loading else -1)
            continue

        if not loading:
            stdscr.timeout(150 if update_jobs else -1)

        render_detail(stdscr, lines, scroll, width, height, mode_config)

        key = stdscr.getch()
        if key == -1:
            continue

        if key == curses.KEY_DOWN:
            if scroll < max(0, len(lines) - viewable):
                scroll += 1
        elif key == curses.KEY_UP:
            if scroll > 0:
                scroll -= 1
        elif key in (curses.KEY_NPAGE, 4):
            scroll = min(scroll + viewable, max(0, len(lines) - viewable))
        elif key in (curses.KEY_PPAGE, 21):
            scroll = max(scroll - viewable, 0)

        elif key == ord("j"):
            if cursor < len(tickets) - 1:
                cursor += 1
                ticket = tickets[cursor]
                scroll = 0
                lines, loading, result_holder = _init_detail_state(ticket, content_width)
                stdscr.timeout(150 if loading else -1)

        elif key == ord("k"):
            if cursor > 0:
                cursor -= 1
                ticket = tickets[cursor]
                scroll = 0
                lines, loading, result_holder = _init_detail_state(ticket, content_width)
                stdscr.timeout(150 if loading else -1)

        elif key == ord("m"):
            comment_text = prompt_for_comment(stdscr)
            stdscr = _restore_curses()
            if comment_text:
                try:
                    add_comment(ticket["key"], comment_text)
                    _comment_cache.pop(ticket["key"], None)
                    show_message(stdscr, f"Comment added to {ticket['key']}.")
                except Exception as e:
                    show_message(stdscr, f"Failed to add comment: {e}")
                lines, loading, result_holder = _init_detail_state(ticket, content_width)
                stdscr.timeout(150 if loading else -1)

        elif key == ord("e"):
            new_summary = prompt_for_summary(stdscr, ticket)
            stdscr = _restore_curses()
            if start_summary_update(ticket, new_summary, update_jobs):
                lines = build_detail_lines(
                    ticket,
                    result_holder.get("comments") if result_holder.get("done") else None,
                    content_width,
                    loading=loading,
                    error=result_holder.get("error"),
                )
                stdscr.timeout(150)

        elif key == ord("E"):
            new_epic_key = prompt_for_epic_link(stdscr, ticket)
            stdscr = _restore_curses()
            if start_epic_link_update(ticket, new_epic_key, update_jobs):
                lines = build_detail_lines(
                    ticket,
                    result_holder.get("comments") if result_holder.get("done") else None,
                    content_width,
                    loading=loading,
                    error=result_holder.get("error"),
                )
                stdscr.timeout(150)

        elif key == ord("a") and "assignee" in mode_config.get("columns", DEFAULT_COLUMNS):
            username = prompt_for_assignee(
                stdscr,
                issue_key=ticket["key"],
                candidates=assignee_candidates(tickets),
            )
            stdscr = _restore_curses()
            if username:
                if start_assignee_update(ticket, username, update_jobs):
                    lines = build_detail_lines(
                        ticket,
                        result_holder.get("comments") if result_holder.get("done") else None,
                        content_width,
                        loading=loading,
                        error=result_holder.get("error"),
                    )
                    stdscr.timeout(150)

        elif key == ord("b"):
            comment_text = prompt_for_comment(stdscr)
            stdscr = _restore_curses()
            if comment_text is not None:
                try:
                    with_status(stdscr, f"Backlog {ticket['key']}...", lambda: transition_backlog(ticket["key"], comment=comment_text))
                    show_message(stdscr, f"{ticket['key']} moved to Backlog.")
                    tickets = with_status(stdscr, "Refreshing...", lambda: fetch_tickets(mode_config))
                    cursor = min(cursor, max(0, len(tickets) - 1))
                    if not tickets:
                        stdscr.timeout(-1)
                        return tickets, cursor
                    ticket = tickets[cursor]
                    scroll = 0
                    lines, loading, result_holder = _init_detail_state(ticket, content_width)
                    stdscr.timeout(150 if loading else -1)
                except Exception as e:
                    show_message(stdscr, f"Failed to transition: {e}")

        elif key == ord("x"):
            comment_text = prompt_for_comment(stdscr)
            stdscr = _restore_curses()
            if comment_text is not None:
                try:
                    with_status(stdscr, f"Won't Fix {ticket['key']}...", lambda: transition_wontfix(ticket["key"], comment=comment_text))
                    show_message(stdscr, f"{ticket['key']} marked Won't Fix.")
                    tickets = with_status(stdscr, "Refreshing...", lambda: fetch_tickets(mode_config))
                    cursor = min(cursor, max(0, len(tickets) - 1))
                    if not tickets:
                        stdscr.timeout(-1)
                        return tickets, cursor
                    ticket = tickets[cursor]
                    scroll = 0
                    lines, loading, result_holder = _init_detail_state(ticket, content_width)
                    stdscr.timeout(150 if loading else -1)
                except Exception as e:
                    show_message(stdscr, f"Failed to transition: {e}")

        elif key == ord("d"):
            comment_text = prompt_for_comment(stdscr)
            stdscr = _restore_curses()
            if comment_text is not None:
                try:
                    with_status(stdscr, f"Closing {ticket['key']}...", lambda: transition_done(ticket["key"], comment=comment_text))
                    show_message(stdscr, f"{ticket['key']} moved to Done.")
                    tickets = with_status(stdscr, "Refreshing...", lambda: fetch_tickets(mode_config))
                    cursor = min(cursor, max(0, len(tickets) - 1))
                    if not tickets:
                        stdscr.timeout(-1)
                        return tickets, cursor
                    ticket = tickets[cursor]
                    scroll = 0
                    lines, loading, result_holder = _init_detail_state(ticket, content_width)
                    stdscr.timeout(150 if loading else -1)
                except Exception as e:
                    show_message(stdscr, f"Failed to transition: {e}")

        elif key == ord("v"):
            open_in_browser(ticket["key"])

        elif key == ord("r"):
            loading = True
            _comment_cache.pop(ticket["key"], None)
            result_holder = {"done": False}
            lines = build_detail_lines(ticket, None, content_width, loading=True)
            thread = threading.Thread(
                target=fetch_comments_async,
                args=(ticket["key"], result_holder),
                daemon=True,
            )
            thread.start()
            stdscr.timeout(150)

        elif key in (ord("q"), ord("\n"), 27):
            stdscr.timeout(-1)
            return tickets, cursor


def curses_main(stdscr, mode_config):
    curses.curs_set(0)
    curses.use_default_colors()
    curses.init_pair(1, curses.COLOR_BLACK, curses.COLOR_CYAN)
    curses.init_pair(2, curses.COLOR_BLACK, curses.COLOR_YELLOW)

    tickets = with_status(stdscr, f"Fetching {mode_config['title']} tickets...", lambda: fetch_tickets(mode_config))
    cursor = 0
    scroll_offset = 0
    selected = set()
    sort_field = None
    sort_reverse = False
    assignee_filter = None  # None = no filter; otherwise an assignee username or "Unassigned"
    columns = mode_config.get("columns", DEFAULT_COLUMNS)
    update_jobs = []
    pending_rank_move = None

    while True:
        height, width = stdscr.getmaxyx()
        header_lines = 2
        footer_lines = 3
        list_height = height - header_lines - footer_lines

        filtered_tickets = filter_tickets_by_assignee(tickets, assignee_filter)

        if filtered_tickets:
            cursor = max(0, min(cursor, len(filtered_tickets) - 1))
            if cursor < scroll_offset:
                scroll_offset = cursor
            elif cursor >= scroll_offset + list_height:
                scroll_offset = cursor - list_height + 1
        else:
            cursor = 0
            scroll_offset = 0

        display_tickets = sort_tickets(filtered_tickets, sort_field, sort_reverse, columns)

        failed_jobs = completed_update_errors(update_jobs)
        if failed_jobs:
            current_key = display_tickets[cursor]["key"] if display_tickets else None
            tickets, cursor = refresh_after_failed_update(
                stdscr,
                mode_config,
                tickets,
                cursor,
                current_key=current_key,
                failed_jobs=failed_jobs,
            )
            scroll_offset = 0
            selected.clear()
            pending_rank_move = None
            continue

        stdscr.timeout(150 if update_jobs else -1)

        stdscr.clear()
        filter_info = assignee_filter_label(assignee_filter)
        pending_rank_key = pending_rank_move["ticket_key"] if pending_rank_move else None
        draw_list(stdscr, display_tickets, cursor, scroll_offset, mode_config, selected, sort_field, sort_reverse, filter_info, pending_rank_key)
        stdscr.refresh()

        key = stdscr.getch()
        if key == -1:
            continue

        if key in (ord("K"), ord("J")):
            if sort_field == "rank" and not sort_reverse and display_tickets:
                old_values_by_key = None
                if pending_rank_move is None:
                    old_values_by_key = capture_rank_overrides(display_tickets)
                elif pending_rank_move["ticket_key"] != display_tickets[cursor]["key"]:
                    pending_cursor = find_ticket_index(display_tickets, pending_rank_move["ticket_key"], None)
                    if pending_cursor is not None:
                        cursor = pending_cursor

                direction = -1 if key == ord("K") else 1
                ticket_key = display_tickets[cursor]["key"]
                cursor, moved = move_ranked_ticket(display_tickets, cursor, direction)
                if moved:
                    if pending_rank_move is None:
                        pending_rank_move = {
                            "ticket_key": ticket_key,
                            "old_values_by_key": old_values_by_key,
                        }
                    selected.clear()

        elif key == curses.KEY_UP or key == ord("k"):
            if cursor > 0:
                cursor -= 1

        elif key == curses.KEY_DOWN or key == ord("j"):
            if cursor < len(display_tickets) - 1:
                cursor += 1

        elif key in (curses.KEY_PPAGE, 21):
            cursor = max(0, cursor - list_height)

        elif key in (curses.KEY_NPAGE, 4):
            cursor = min(len(display_tickets) - 1, cursor + list_height)

        elif key == ord("g"):
            cursor = 0

        elif key == ord("G"):
            cursor = len(display_tickets) - 1

        elif key == ord(" "):
            cursor = min(len(display_tickets) - 1, cursor + list_height)

        elif key == curses.KEY_SPREVIOUS or key == 353:
            cursor = max(0, cursor - list_height)

        elif key == ord("."):
            if display_tickets:
                if cursor in selected:
                    selected.discard(cursor)
                else:
                    selected.add(cursor)
                if cursor < len(display_tickets) - 1:
                    cursor += 1

        elif key == ord("s"):
            if pending_rank_move:
                restore_rank_overrides(tickets, pending_rank_move["old_values_by_key"])
                pending_rank_move = None
            available = [f for f in SORTABLE_FIELDS if f != "component" or "component" in columns]
            if not sort_field:
                sort_field = available[0]
                sort_reverse = False
            elif not sort_reverse:
                sort_reverse = True
            else:
                idx = available.index(sort_field)
                if idx + 1 < len(available):
                    sort_field = available[idx + 1]
                    sort_reverse = False
                else:
                    sort_field = None
                    sort_reverse = False
            cursor = 0
            scroll_offset = 0
            selected.clear()

        elif key == ord("f"):
            if pending_rank_move:
                restore_rank_overrides(tickets, pending_rank_move["old_values_by_key"])
                pending_rank_move = None
            assignee_filter = next_assignee_filter(tickets, assignee_filter)
            cursor = 0
            scroll_offset = 0
            selected.clear()

        elif key == ord("\n"):
            if pending_rank_move:
                rank_tickets = sort_tickets(filtered_tickets, "rank", False, columns)
                ticket_key = pending_rank_move["ticket_key"]
                rank_cursor = find_ticket_index(rank_tickets, ticket_key, None)
                if rank_cursor is not None:
                    target_key, placement = rank_target_for_position(rank_tickets, ticket_key)
                    if target_key:
                        enqueue_rank_update(
                            rank_tickets[rank_cursor],
                            target_key,
                            placement,
                            update_jobs,
                            old_values_by_key=pending_rank_move["old_values_by_key"],
                        )
                    cursor = rank_cursor
                    scroll_offset = 0
                pending_rank_move = None
                selected.clear()
            elif display_tickets:
                tickets, cursor = show_description_screen(stdscr, display_tickets, cursor, mode_config, update_jobs)
                selected.clear()

        elif key == ord("e"):
            if display_tickets:
                ticket = display_tickets[cursor]
                new_summary = prompt_for_summary(stdscr, ticket)
                stdscr = _restore_curses()
                start_summary_update(ticket, new_summary, update_jobs)
                selected.clear()

        elif key == ord("E"):
            if display_tickets:
                ticket = display_tickets[cursor]
                new_epic_key = prompt_for_epic_link(stdscr, ticket)
                stdscr = _restore_curses()
                start_epic_link_update(ticket, new_epic_key, update_jobs)
                selected.clear()

        elif key == ord("m"):
            if display_tickets:
                targets = [display_tickets[i] for i in sorted(selected)] if selected else [display_tickets[cursor]]
                n = len(targets)
                keys_preview = ", ".join(t["key"] for t in targets[:5])
                if n > 5:
                    keys_preview += f" (+{n - 5} more)"
                comment_text = prompt_for_comment(stdscr, header=f"Comment on: {keys_preview}")
                stdscr = _restore_curses()
                if comment_text:
                    failed = []
                    for i, t in enumerate(targets):
                        try:
                            with_status(stdscr, f"Commenting on {t['key']} ({i+1}/{n})...", lambda tk=t["key"]: add_comment(tk, comment_text))
                            _comment_cache.pop(t["key"], None)
                        except Exception as e:
                            failed.append((t["key"], e))
                    if failed:
                        show_message(stdscr, f"Failed to comment on {len(failed)}/{n} ticket(s).")
                    else:
                        show_message(stdscr, f"Comment added to {n} ticket(s).")
                    selected.clear()

        elif key == ord("a") and "assignee" in columns:
            if display_tickets:
                targets = [display_tickets[i] for i in sorted(selected)] if selected else [display_tickets[cursor]]
                username = prompt_for_assignee(
                    stdscr,
                    issue_key=targets[0]["key"],
                    candidates=assignee_candidates(tickets),
                )
                stdscr = _restore_curses()
                if username:
                    for t in targets:
                        start_assignee_update(t, username, update_jobs)
                    selected.clear()
                    cursor = min(cursor, max(0, len(tickets) - 1))
                    scroll_offset = 0

        elif key == ord("b"):
            if display_tickets:
                targets = [display_tickets[i] for i in sorted(selected)] if selected else [display_tickets[cursor]]
                n = len(targets)
                keys_preview = ", ".join(t["key"] for t in targets[:5])
                if n > 5:
                    keys_preview += f" (+{n - 5} more)"
                comment_text = prompt_for_comment(stdscr, header=f"Backlog: {keys_preview}")
                stdscr = _restore_curses()
                if comment_text is not None:
                    failed = []
                    for i, t in enumerate(targets):
                        try:
                            with_status(stdscr, f"Backlog {t['key']} ({i+1}/{n})...", lambda tk=t["key"]: transition_backlog(tk, comment=comment_text))
                        except Exception as e:
                            failed.append((t["key"], e))
                    if failed:
                        show_message(stdscr, f"Backlog with errors: {len(failed)}/{n} failed.")
                    else:
                        show_message(stdscr, f"{n} ticket(s) moved to Backlog.")
                    selected.clear()
                    tickets = with_status(stdscr, "Refreshing...", lambda: fetch_tickets(mode_config))
                    pending_rank_move = None
                    cursor = min(cursor, max(0, len(tickets) - 1))
                    scroll_offset = 0
                else:
                    selected.clear()

        elif key == ord("x"):
            if display_tickets:
                targets = [display_tickets[i] for i in sorted(selected)] if selected else [display_tickets[cursor]]
                n = len(targets)
                keys_preview = ", ".join(t["key"] for t in targets[:5])
                if n > 5:
                    keys_preview += f" (+{n - 5} more)"
                comment_text = prompt_for_comment(stdscr, header=f"Won't Fix: {keys_preview}")
                stdscr = _restore_curses()
                if comment_text is not None:
                    failed = []
                    for i, t in enumerate(targets):
                        try:
                            with_status(stdscr, f"Won't Fix {t['key']} ({i+1}/{n})...", lambda tk=t["key"]: transition_wontfix(tk, comment=comment_text))
                        except Exception as e:
                            failed.append((t["key"], e))
                    if failed:
                        show_message(stdscr, f"Won't Fix with errors: {len(failed)}/{n} failed.")
                    else:
                        show_message(stdscr, f"{n} ticket(s) marked Won't Fix.")
                    selected.clear()
                    tickets = with_status(stdscr, "Refreshing...", lambda: fetch_tickets(mode_config))
                    pending_rank_move = None
                    cursor = min(cursor, max(0, len(tickets) - 1))
                    scroll_offset = 0
                else:
                    selected.clear()

        elif key == ord("d"):
            if display_tickets:
                targets = [display_tickets[i] for i in sorted(selected)] if selected else [display_tickets[cursor]]
                n = len(targets)
                keys_preview = ", ".join(t["key"] for t in targets[:5])
                if n > 5:
                    keys_preview += f" (+{n - 5} more)"
                comment_text = prompt_for_comment(stdscr, header=f"Moving to Done: {keys_preview}")
                stdscr = _restore_curses()
                if comment_text is not None:
                    failed = []
                    for i, t in enumerate(targets):
                        try:
                            with_status(stdscr, f"Closing {t['key']} ({i+1}/{n})...", lambda tk=t["key"]: transition_done(tk, comment=comment_text))
                        except Exception as e:
                            failed.append((t["key"], e))
                    if failed:
                        show_message(stdscr, f"Done with errors: {len(failed)}/{n} failed.")
                    else:
                        show_message(stdscr, f"{n} ticket(s) moved to Done.")
                    selected.clear()
                    tickets = with_status(stdscr, "Refreshing...", lambda: fetch_tickets(mode_config))
                    pending_rank_move = None
                    cursor = min(cursor, max(0, len(tickets) - 1))
                    scroll_offset = 0
                else:
                    selected.clear()

        elif key == ord("v"):
            if display_tickets:
                open_in_browser(display_tickets[cursor]["key"])

        elif key == ord("r"):
            tickets = with_status(stdscr, "Refreshing...", lambda: fetch_tickets(mode_config))
            pending_rank_move = None
            cursor = 0
            scroll_offset = 0
            selected.clear()

        elif key == ord("q"):
            break


def main():
    mode_name = sys.argv[1] if len(sys.argv) > 1 else "reported"

    if mode_name == "parent":
        if len(sys.argv) < 3:
            print("Usage: jira-triage parent <TICKET-KEY>")
            sys.exit(1)
        parent_key = sys.argv[2].upper()
        mode_config = {
            "title": f"Children of {parent_key}",
            "jql": (
                f'issue in linkedIssues("{parent_key}", "is a parent of") '
                "ORDER BY key ASC"
            ),
            "columns": ["key", "component", "status", "type", "assignee", "summary"],
        }
    elif mode_name == "epic":
        if len(sys.argv) < 3:
            print("Usage: jira-triage epic <TICKET-KEY>")
            sys.exit(1)
        epic_key = sys.argv[2].upper()
        mode_config = {
            "title": f"Epic: {epic_key}",
            "jql": (
                f'"Epic Link" = {epic_key} AND {STATUS_EXCLUSION} '
                "ORDER BY key ASC"
            ),
            "columns": ["key", "component", "status", "type", "assignee", "summary"],
        }
    elif mode_name not in MODES:
        print(f"Usage: jira-triage [{' | '.join(MODES.keys())} | parent <KEY> | epic <KEY>]")
        sys.exit(1)
    else:
        mode_config = MODES[mode_name]

    curses.wrapper(lambda stdscr: curses_main(stdscr, mode_config))


if __name__ == "__main__":
    main()
